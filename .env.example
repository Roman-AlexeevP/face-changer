# Telegram
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
TG_ADMIN_IDS=123456789

# База
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/facechanger
# Отдельная база для интеграционных тестов (сервис postgres-test)
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/facechanger_test

# Движок
ENGINE=mock
HF_KEY_ID=
HF_KEY_SECRET=
HF_BASE_URL=https://api.higgsfield.ai
HF_MODEL=
HF_UPLOAD_URL=
HF_TIMEOUT_SEC=30
HF_POLL_INTERVAL_SEC=3
HF_POLL_MAX_MIN=8

# Экономика и лимиты
PRICE_KOPECKS=29900
CREDITS_PER_ORDER=1
ENGINE_CREDITS_HINT=0
DAILY_GENERATION_CAP=30
SALES_ENABLED=true
JOB_TIMEOUT_MIN=8
JOB_STALE_MINUTES=12
WORKER_CONCURRENCY=2

# Хранилище
STORAGE=local
STORAGE_DIR=/data/tmp
STORAGE_URL_TTL_MIN=15

# Оплата
PAYMENT_PROVIDER=stub
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Логи
LOG_LEVEL=INFO
